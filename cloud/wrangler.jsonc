{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "synesthesia-presets",
  "account_id": "ecdb8df324a8713baec2d0b0ac88e49e",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://dmitryweiner.github.io http://localhost:5173 http://localhost:4173"
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "synesthesia-presets",
    "database_id": "0a0f3551-69bb-4b0c-8e7f-7efe516a9535",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [
    { "name": "SAVE_LIMIT", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
    { "name": "READ_LIMIT", "namespace_id": "2002", "simple": { "limit": 300, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
