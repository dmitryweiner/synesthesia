{
  "name": "synesthesia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run core && vite",
    "build": "npm run core && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run core && tsc --noEmit && eslint . && vitest run",
    "smoke": "npm run core && node scripts/smoke.mjs",
    "snap": "node scripts/snap.mjs",
    "analyze": "node scripts/analyze.mjs",
    "check:cloud": "cd cloud && npm run check && npm test",
    "deploy:cloud": "cd cloud && npx wrangler d1 migrations apply synesthesia-presets --remote && npx wrangler deploy",
    "core": "node scripts/build-core.mjs && node scripts/fetch-bank.mjs",
    "bench:core": "npm run core && node scripts/core-bench.mjs",
    "bench:serve": "npm run core && SYN_HTTPS=1 vite --host"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "eslint": "^10.5.0",
    "playwright": "^1.61.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "synesthesiaCore": {
    "repo": "https://github.com/dmitryweiner/synesthesia-core",
    "rev": "0319aa1869627883a4dfeff0e0d3e5ccd3b75b2f"
  },
  "synesthesiaSamples": {
    "bank": "https://github.com/dmitryweiner/synesthesia-samples/releases/download/bank-v1/bank.bin",
    "sha256": "c6ec462a3e057b41ca82a918427f7d7be4efd1c0a437f80a628e2f1cac9bd335"
  }
}
